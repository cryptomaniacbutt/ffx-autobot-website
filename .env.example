# ============================================================
# FFX Autobot Trading — environment variables
# Copy the two Turso values from your Turso dashboard
# (see the deployment guide, Part 2)
# ============================================================

# --- Production: Turso database (used on Vercel) ---
# Turso → your database → "URL"  (starts with libsql://)
TURSO_DATABASE_URL="libsql://your-database-name-your-organization.turso.io"

# Turso → your database → Tokens → generate (starts with eyJ...)
TURSO_AUTH_TOKEN="eyJhbGciOiJFzCI6..."

# --- Local development only (SQLite file) ---
# Used automatically when the two Turso variables above are NOT set.
DATABASE_URL="file:./db/custom.db"
